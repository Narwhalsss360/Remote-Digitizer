<UserControl x:Class="Common.WindowTitleBarControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Common"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:WindowTitleBarControls, IsDesignTimeCreatable=True}"
             d:DesignWidth="{StaticResource DefaultWindowWidth}" d:DesignHeight="{StaticResource StatusBarHeight}"
             >
    <Control.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Common;component/WindowStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Control.Resources>
    <DockPanel x:Name="TitleBarDockPanel" HorizontalAlignment="Stretch">
        <DockPanel.Background>
            <SolidColorBrush Color="{StaticResource AlternateBackgroundColor}" />
        </DockPanel.Background>
        <TextBlock Margin="10, 0, 0, 0" Text="{Binding Title}">
            <TextBlock.Foreground>
                <SolidColorBrush Color="{StaticResource ForegroundColor}"/>
            </TextBlock.Foreground>
        </TextBlock>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
            <Border x:Name="MinimizeButton" Height="10" MouseDown="ButtonClick" MouseEnter="ButtonMouseEnter" MouseLeave="ButtonMouseLeave" Width="10" Margin="0, 0, 7, 0" CornerRadius="5" Background="Yellow"/>
            <Border x:Name="MaximizeButton" Height="10" MouseDown="ButtonClick" MouseEnter="ButtonMouseEnter" MouseLeave="ButtonMouseLeave" Width="10" Margin="0, 0, 7, 0" CornerRadius="5" Background="SpringGreen" OpacityMask="Black"/>
            <Border x:Name="CloseButton" Height="10" MouseDown="ButtonClick" MouseEnter="ButtonMouseEnter" MouseLeave="ButtonMouseLeave" Width="10" Margin="0, 0, 6, 0" CornerRadius="5" Background="Red"/>
        </StackPanel>
    </DockPanel>
</UserControl>
