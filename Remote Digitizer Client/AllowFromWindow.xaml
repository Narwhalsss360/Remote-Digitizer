<Window x:Class="Remote_Digitizer_Client.AllowFromWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Remote_Digitizer_Client"
        mc:Ignorable="d"
        Title="AllowFromWindow" Height="450" Width="800"
        d:DataContext="{d:DesignInstance Type=local:AllowFromWindow, IsDesignTimeCreatable=False}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Common;component/WindowStyle.xaml" />
                <ResourceDictionary>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlockStyle}" />
                    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="10">
        <Button DockPanel.Dock="Bottom" Margin="0, 10, 0, 0" Click="ApplyAndClose" MinHeight="25">
            <TextBlock Text="Apply &#x26; Close"/>
        </Button>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="True" HorizontalAlignment="Stretch" MinHeight="25" MaxHeight="45" Margin="0, 10, 0, 0">
            <Button DockPanel.Dock="Right" Click="AddClick">
                <TextBlock Text="Add" Margin="4" VerticalAlignment="Center" />
            </Button>
            <TextBox x:Name="AddTextBox" DockPanel.Dock="Left" Margin="0, 0, 5, 0" VerticalContentAlignment="Center"/>
        </DockPanel>
        <ListBox DockPanel.Dock="Top" x:Name="AddressListBox" ItemsSource="{Binding Addresses}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel HorizontalAlignment="Stretch" LastChildFill="False">
                        <TextBlock Text="{Binding Address}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem, AncestorLevel=1}}" Click="RemoveClick">
                            <TextBlock Margin="3" Text="Remove" Foreground="Red" VerticalAlignment="Center" />
                        </Button>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
