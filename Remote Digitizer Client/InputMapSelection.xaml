<UserControl x:Class="Remote_Digitizer_Client.InputMapSelection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:local="clr-namespace:Remote_Digitizer_Client"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:InputMapSelection, IsDesignTimeCreatable=True}"
             d:DesignHeight="110" d:DesignWidth="220">
    <Control.Resources>
        <ObjectDataProvider x:Key="InputTypeDataSource" ObjectType="{x:Type sys:Enum}" MethodName="GetValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:InputMapSelection+StylusInputType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Control.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".15*" />
            <RowDefinition Height=".425*" />
            <RowDefinition Height=".425*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" Margin="2, 0, 0, 0"/>

        <ComboBox x:Name="InputTypeCombo" Grid.Row="1" Margin="0, 1, 0, 2" FontSize="14" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" ItemsSource="{Binding Source={StaticResource InputTypeDataSource}}" SelectedIndex="0" />
        <TextBox x:Name="InputTextBox" Grid.Row="2" Margin="0, 2, 0, 0" VerticalContentAlignment="Center" IsEnabled="False" />
    </Grid>
</UserControl>
