<Window x:Class="Remote_Digitizer_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Remote_Digitizer_Client"
        xmlns:c="clr-namespace:Common;assembly=Common"
        mc:Ignorable="d"
        Title="Remote Digitizer Client">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Common;component/WindowStyle.xaml" />
                <ResourceDictionary Source="/Common;component/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <Style BasedOn="{StaticResource ResourceKey=CommonWindowStyle}" TargetType="Window">
            <Setter Property="Width" Value="400" />
            <Setter Property="Height" Value="200" />
        </Style>
    </Window.Style>

    <Border x:Name="MainBorder" Style="{DynamicResource MainWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource TitleBarHeightGridLength}" />
                <RowDefinition />
                <RowDefinition Height="{StaticResource StatusBarHeightGridLength}" />
            </Grid.RowDefinitions>

            <c:WindowTitleBarControls x:Name="TitleBarControls" Title="Remote Digitizer Client" HorizontalAlignment="Stretch" Minimize="WindowTitleBarControls_Minimize" Maximize="WindowTitleBarControls_Maximize" Close="WindowTitleBarControls_Close">
                <Control.Clip>
                    <RectangleGeometry Rect="{Binding Converter={StaticResource BorderToRectConverter}, ElementName=MainBorder, Mode=OneWay}"
                       RadiusX="{Binding Converter={StaticResource BorderToSingleRadiusConverter}, ElementName=MainBorder, Mode=OneWay}"
                       RadiusY="{Binding Converter={StaticResource BorderToSingleRadiusConverter}, ElementName=MainBorder, Mode=OneWay}" />
                </Control.Clip>
            </c:WindowTitleBarControls>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PositionTextBox" Grid.Row="0" Foreground="{StaticResource ActiveForegroundColor}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="28" Text="(-.--- ,-.---)"/>
                <TextBlock x:Name="StatusTextBox" Grid.Row="1" Foreground="{StaticResource ActiveForegroundColor}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="28" Text="Not Drawing"/>
            </Grid>

            <DockPanel x:Name="StatusBarPanel" Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{StaticResource AlternateBackgroundColor}">
                <DockPanel.Clip>
                    <RectangleGeometry Rect="0, -10, 500, 25" RadiusX="10" RadiusY="10" />
                </DockPanel.Clip>
                <TextBlock x:Name="ConnectionStatusTextBlock" Margin="5, 0, 0, 0" DockPanel.Dock="Left" Text="Disconnected" VerticalAlignment="Center" Foreground="{StaticResource ForegroundColor}" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
