<Window x:Class="Remote_Digitizer_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Remote_Digitizer_Client"
        xmlns:c="clr-namespace:Common;assembly=Common"
        mc:Ignorable="d"
        Title="Remote Digitizer Client">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Common;component/WindowStyle.xaml" />
                <ResourceDictionary Source="/Common;component/Converters.xaml" />
                <ResourceDictionary>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlockStyle}" />
                    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <Style BasedOn="{StaticResource ResourceKey=CommonWindowStyle}" TargetType="Window">
            <Setter Property="Width" Value="440" />
            <Setter Property="Height" Value="330" />
        </Style>
    </Window.Style>

    <Border x:Name="MainBorder" Style="{DynamicResource MainWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource TitleBarHeightGridLength}" />
                <RowDefinition />
                <RowDefinition Height="{StaticResource StatusBarHeightGridLength}" />
            </Grid.RowDefinitions>

            <c:WindowTitleBarControls x:Name="TitleBarControls" Title="Remote Digitizer Client" HorizontalAlignment="Stretch" Minimize="WindowTitleBarControls_Minimize" Maximize="WindowTitleBarControls_Maximize" Close="WindowTitleBarControls_Close">
                <Control.Clip>
                    <RectangleGeometry Rect="{Binding Converter={StaticResource BorderToRectConverter}, ElementName=MainBorder, Mode=OneWay}"
                       RadiusX="{Binding Converter={StaticResource BorderToSingleRadiusConverter}, ElementName=MainBorder, Mode=OneWay}"
                       RadiusY="{Binding Converter={StaticResource BorderToSingleRadiusConverter}, ElementName=MainBorder, Mode=OneWay}" />
                </Control.Clip>
            </c:WindowTitleBarControls>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid Margin="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height=".15*"/>
                        <RowDefinition Height=".425*"/>
                        <RowDefinition Height=".425*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Profile &#x26; Connection"/>
                    <Grid Grid.Row="1" Margin="0, 1, 0, 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".65*"/>
                            <ColumnDefinition Width=".175*"/>
                            <ColumnDefinition Width=".175*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="ProfileComboBox" Grid.Row="1" IsEditable="True" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Click="DeleteProfileClick" Style="{StaticResource DefaultButtonStyle}">
                            <TextBlock Foreground="Red" Text="x"/>
                        </Button>
                        <Button Grid.Column="2" Click="AddProfileClick" Style="{StaticResource DefaultButtonStyle}">
                            <TextBlock Text="+" Style="{StaticResource DefaultTextBlockStyle}" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0, 2, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".8*"/>
                            <ColumnDefinition Width=".2*"/>
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource DefaultButtonStyle}" Click="ToggleListen">
                            <TextBlock x:Name="ListenToggleButtonText" Text="Listen" Style="{StaticResource DefaultTextBlockStyle}"/>
                        </Button>
                        <Button Grid.Column="1"  Style="{StaticResource DefaultButtonStyle}" Click="OpenAllowFromSettings">
                            <TextBlock Text="&#x2699;" Style="{StaticResource DefaultTextBlockStyle}" />
                        </Button>
                    </Grid>
                </Grid>

                <local:InputMapSelection x:Name="EnteredNormallyMap" Title="Entered Normally"  Grid.Column="1" Margin="3" />
                <local:InputMapSelection x:Name="EnteredAlternateMap" Title="Entered Alternate" Grid.Row="1" Margin="3" />
                <local:InputMapSelection x:Name="EnteredInvertedMap" Title="Entered Inverted" Grid.Row="1" Grid.Column="1" Margin="3" />
                <local:InputMapSelection x:Name="TouchMap" Title="Touch" Grid.Row="2" Margin="3" />

                <Grid Grid.Row="2" Grid.Column="1" Margin="0, 18, 0, 3">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PositionTextBox" Grid.Row="0" Style="{StaticResource DefaultTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Text="(-.--- ,-.---)"/>
                    <TextBlock x:Name="StatusTextBox" Grid.Row="1" Style="{StaticResource DefaultTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Not Drawing"/>
                </Grid>
            </Grid>

            <DockPanel x:Name="StatusBarPanel" Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <DockPanel.Background>
                    <SolidColorBrush Color="{StaticResource AlternateBackgroundColor}" />
                </DockPanel.Background>
                <DockPanel.Clip>
                    <RectangleGeometry Rect="0, -10, 500, 25" RadiusX="10" RadiusY="10" />
                </DockPanel.Clip>
                <TextBlock x:Name="ConnectionStatusTextBlock" Style="{StaticResource DefaultTextBlockStyle}" Margin="5, 0, 0, 0" DockPanel.Dock="Left" Text="Standby" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
