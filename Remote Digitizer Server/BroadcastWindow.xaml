<Window x:Class="Remote_Digitizer_Server.BroadcastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Remote_Digitizer_Server"
        mc:Ignorable="d"
        Title="{Binding IPAddress}" Height="450" Width="800"
        d:DataContext="{d:DesignInstance Type=local:BroadcastWindow, IsDesignTimeCreatable=True}">
    <Frame x:Name="CanvasFrame" Margin="{Binding StylusCanvasMargin}" Background="#7F000000">

    </Frame>
</Window>
