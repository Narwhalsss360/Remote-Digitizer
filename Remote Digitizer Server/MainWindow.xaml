<Window x:Class="Remote_Digitizer_Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Remote_Digitizer_Server"
        xmlns:c="clr-namespace:Common;assembly=Common"
        mc:Ignorable="d"
        Title="Remote Digitzer Server">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Common;component/WindowStyle.xaml" />
                <ResourceDictionary Source="/Common;component/Converters.xaml" />
                <ResourceDictionary>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlockStyle}" />
                    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <Style BasedOn="{StaticResource ResourceKey=CommonWindowStyle}" TargetType="Window">
            <Setter Property="Width" Value="400" />
            <Setter Property="Height" Value="200" />
        </Style>
    </Window.Style>

    <Border x:Name="MainBorder" Style="{DynamicResource MainWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource TitleBarHeightGridLength}" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <c:WindowTitleBarControls x:Name="TitleBarControls" Title="Remote Digitizer Server" HorizontalAlignment="Stretch" Minimize="WindowTitleBarControls_Minimize" Maximize="WindowTitleBarControls_Maximize" Close="WindowTitleBarControls_Close">
                <Control.Clip>
                    <RectangleGeometry Rect="{Binding Converter={StaticResource BorderToRectConverter}, ElementName=MainBorder, Mode=OneWay}"
                                       RadiusX="{Binding Converter={StaticResource BorderToSingleRadiusConverter}, ElementName=MainBorder, Mode=OneWay}"
                                       RadiusY="{Binding Converter={StaticResource BorderToSingleRadiusConverter}, ElementName=MainBorder, Mode=OneWay}" />
                </Control.Clip>
            </c:WindowTitleBarControls>

            <DockPanel Grid.Row="1" VerticalAlignment="Stretch">
                <DockPanel DockPanel.Dock="Top" Margin="3" MaxHeight="25" VerticalAlignment="Top">
                    <Button DockPanel.Dock="Right" Click="StartBroadcast" Style="{StaticResource DefaultButtonStyle}">
                        <TextBlock Text="Broadcast" VerticalAlignment="Center" Margin="2" />
                    </Button>
                    <TextBox x:Name="IPEntry" DockPanel.Dock="Left" Margin="0, 0, 5, 0"  VerticalContentAlignment="Center" />
                </DockPanel>
                <Grid DockPanel.Dock="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PositionTextBlock" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center" Text="(---, ---)" />
                    <TextBlock x:Name="StateTextBlock" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1" Text="Not Drawing" />
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
